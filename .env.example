DATABASE_URL="mongodb://127.0.0.1:27018/signoff"
# Prisma MongoDB requires a replica set. Compass standalone (27017) cannot accept Prisma writes.
# A local replica is used on 27018. To use 27017, enable replication.replSetName: rs0 in mongod.cfg and run rs.initiate().
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"
# Optional: POST /api/reminders/run?secret=...
REMINDER_SECRET=""
